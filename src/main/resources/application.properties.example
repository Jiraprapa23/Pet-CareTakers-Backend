spring.application.name=springboot
server.port=8096

spring.datasource.url=jdbc:mysql://localhost:3306/ppproject?useSSL=false&serverTimezone=Asia/Bangkok&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jackson.time-zone=Asia/Bangkok

spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB
spring.servlet.multipart.enabled=true
server.tomcat.max-http-form-post-size=-1
server.tomcat.max-parameter-count=10000

file.upload-dir.owners=YOUR_LOCAL_PATH/public/images/owners/
file.upload-dir.sitters=YOUR_LOCAL_PATH/public/images/sitters/
file.upload-dir.qrcodes=YOUR_LOCAL_PATH/public/images/qrcodes/
file.upload-dir.pets=YOUR_LOCAL_PATH/public/images/pets/
file.upload-dir.reports=YOUR_LOCAL_PATH/public/images/reports/
file.upload-dir.slips=YOUR_LOCAL_PATH/public/images/slips/

spring.mvc.cors.allowed-origins=*
spring.mvc.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.mvc.cors.allowed-headers=*
